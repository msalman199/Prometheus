promtool check config /etc/prometheus/prometheus.yml
echo

# Check targets status
echo "5. Checking targets status:"
curl -s http://localhost:9090/api/v1/targets | python3 -m json.tool 2>/dev/null || echo "Failed to get targets status"
echo

# Check recent logs for errors
echo "6. Recent error logs:"
journalctl -u prometheus --since "5 minutes ago" --no-pager | grep -i error || echo "No recent errors found"
Make the script executable and run it:

