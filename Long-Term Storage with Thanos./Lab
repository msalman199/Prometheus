Advanced Configuration
Configure Retention Policies
# Create advanced retention configuration
tee ~/thanos-lab/thanos/config/retention.yml > /dev/null <<EOF
retention:
  raw: 30d
  5m: 90d
  1h: 1y
EOF
Set Up Alerting Rules
# Create alerting rules for Thanos
sudo mkdir -p /etc/prometheus/rules

sudo tee /etc/prometheus/rules/thanos.yml > /dev/null <<EOF
groups:
- name: thanos
  rules:
  - alert: ThanosQueryHttpRequestQueryErrorRateHigh
    expr: |
      (
        sum(rate(http_requests_total{code=~"5..", job=~"thanos-query.*", handler="query"}[5m]))
      /
        sum(rate(http_requests_total{job=~"thanos-query.*", handler="query"}[5m]))
      ) > 0.05
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Thanos Query is failing to handle requests.

  - alert: ThanosStoreGrpcErrorRateHigh
    expr: |
      (
        sum(rate(grpc_server_handled_total{grpc_code=~"Unknown|ResourceExhausted|Internal|Unavailable|DataLoss|DeadlineExceeded", job=~"thanos-store.*"}[5m]))
      /
        sum(rate(grpc_server_started_total{job=~"thanos-store.*"}[5m]))
      ) > 0.05
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: Thanos Store is failing to handle requests.
EOF

# Update Prometheus configuration to include rules
sudo sed -i '/rule_files:/a\  - "/etc/prometheus/rules/*.yml"' /etc/prometheus/prometheus.yml

# Reload Prometheus configuration
curl -X POST http://localhost:9090/-/reload
