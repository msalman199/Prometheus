Group=prometheus
Type=simple
ExecStart=/usr/local/bin/thanos query \\
    --http-address=0.0.0.0:10904 \\
    --grpc-address=0.0.0.0:10903 \\
    --store=localhost:10901 \\
    --store=localhost:10905

[Install]
WantedBy=multi-user.target
EOF

# Start Thanos Query
sudo systemctl daemon-reload
