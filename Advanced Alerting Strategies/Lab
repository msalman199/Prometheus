Task 3: Build Alert Routing, Inhibition, and a Webhook Receiver
Requirement 1
Design and implement a Python-based HTTP webhook server that listens on port 5001, accepts POST requests from Alertmanager, parses the JSON payload, and prints a structured summary to stdout for each received alert showing: alert name, status (firing or resolved), severity, instance, summary annotation, and the UTC timestamp of receipt. The server must remain running as a background process for the duration of this task.

# Step 1 â Write the webhook server
cat > /tmp/webhook_server.py <<'PYEOF'
#!/usr/bin/env python3
import json
from http.server import HTTPServer, BaseHTTPRequestHandler
from datetime import datetime, timezone

class WebhookHandler(BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length)
        try:
            payload = json.loads(body.decode('utf-8'))
            ts = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
            print(f"\n{'='*60}")
            print(f"Webhook received at {ts}  endpoint={self.path}")
            for alert in payload.get('alerts', []):
                labels = alert.get('labels', {})
                annotations = alert.get('annotations', {})
                print(f"  alertname : {labels.get('alertname', 'unknown')}")
                print(f"  status    : {alert.get('status', 'unknown')}")
                print(f"  severity  : {labels.get('severity', 'unknown')}")
                print(f"  instance  : {labels.get('instance', 'unknown')}")
                print(f"  summary   : {annotations.get('summary', 'none')}")
                print(f"  ---")
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b'{"status":"ok"}')
        except Exception as exc:
            print(f"Parse error: {exc}")
            self.send_response(400)
            self.end_headers()

    def log_message(self, fmt, *args):
        pass

HTTPServer(('0.0.0.0', 5001), WebhookHandler).serve_forever()
PYEOF

